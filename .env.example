# DSP Power Infra — backend environment template.
# Copy to .env (never committed) or export these before starting the backend.
# Local development works with the defaults baked into application.properties;
# production MUST override every secret below and set SPRING_PROFILES_ACTIVE=prod
# (the prod profile refuses to boot with default credentials).

# --- Server ---
SERVER_PORT=8081
# Activate the fail-fast secret guard in production:
# SPRING_PROFILES_ACTIVE=prod

# --- Database (MySQL 8.4) ---
DB_URL=jdbc:mysql://localhost:3306/dsp_power_infra
DB_USERNAME=dsp_dev
DB_PASSWORD=change-me-db

# --- Admin desk (HTTP Basic) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# --- Serviceability ---
# Comma-separated PIN prefixes treated as the confirmed service region.
SERVICEABLE_PREFIXES=411,412

# --- New-lead email notification (optional, off by default) ---
NOTIFY_ENABLED=false
NOTIFY_TO=leads@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=